PanelWidgetClass GZLibraryRow {
 visible 1
 ignorepointer 0
 color 0.1412 0.1569 0.1804 1
 position 0 0
 size 1 26
 hexactpos 1
 vexactpos 1
 hexactsize 0
 vexactsize 1
 scaled 1
 draggable 1
 style rover_sim_colorable
 {
  FrameWidgetClass IconFrame {
   ignorepointer 1
   position 0 0
   size 34 1
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 0
   scriptclass ""
   {
    ImageWidgetClass Icon {
     ignorepointer 1
     size 18 18
     halign center_ref
     valign center_ref
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     scaled 1
     scriptclass "SymbolHandler"
     mode blend
     "src alpha" 1
     filter 1
     {
      ScriptParamsClass {
       Symbol_Name "cube"
       Symbol_Size 3
      }
     }
    }
   }
  }
  TextWidgetClass Label {
   ignorepointer 1
   position 34 0
   size 460 1
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 0
   text "Prefab"
   font "gui/fonts/Metron"
   "size to text h" 0
   "text valign" center
  }
 }
}
